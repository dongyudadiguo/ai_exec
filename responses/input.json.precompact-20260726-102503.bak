        "arguments": "{\"code\":\"from pathlib import Path\\nimport ast, re, subprocess, tempfile, shutil\\nfrom html.parser import HTMLParser\\nroot=Path(r'C:\\\\Users\\\\12159\\\\Desktop\\\\ai_exec')\\npaths=[root/x/'viewer.py' for x in ('responses','chat_completions','messages')]\\nnode=shutil.which('node')\\nclass Scripts(HTMLParser):\\n    def __init__(self): super().__init__();self.ins=False;self.cur=[];self.scripts=[];self.src=[]\\n    def handle_starttag(self,tag,attrs):\\n        if tag.lower()=='script':self.ins=True;self.cur=[];self.src.append(dict(attrs).get('src'))\\n    def handle_data(self,d):\\n        if self.ins:self.cur.append(d)\\n    def handle_endtag(self,tag):\\n        if tag.lower()=='script' and self.ins:self.scripts.append(''.join(self.cur));self.ins=False\\nfor p in paths:\\n    text=p.read_text('utf8')\\n    try: compile(text,str(p),'exec'); py='OK'\\n    except Exception as e: py=f'FAIL {e}'\\n    tree=ast.parse(text)\\n    page=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='PAGE' for t in n.targets))\\n    h=Scripts();h.feed(page)\\n    js=[]\\n    td=Path(tempfile.mkdtemp())\\n    try:\\n        for i,s in enumerate(h.scripts):\\n            if not s.strip(): continue\\n            q=td/f'{i}.js';q.write_text(s,'utf8')\\n            cp=subprocess.run([node,'--check',str(q)],capture_output=True,text=True,encoding='utf8',errors='replace')\\n            js.append((i,cp.returncode,cp.stderr[:500]))\\n    finally: shutil.rmtree(td,ignore_errors=True)\\n    print(p.parent.name,'Python',py,'scripts',len(h.scripts),'Node',[(i,rc) for i,rc,_ in js])\\n    for i,rc,err in js:\\n        if rc: print(err)\\n    print(' restore refs',text.count('_restore_active_input()'),'state signature',text.count('\\\"signature\\\"'),'invalidateUsage refs',text.count('invalidateUsage'))\"}",
