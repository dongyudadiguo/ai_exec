      {
        "arguments": "{\"code\":\"from pathlib import Path\\nimport importlib.util, tempfile, json, os, shutil, time\\nbase=Path(r'C:\\\\Users\\\\12159\\\\Desktop\\\\ai_exec')\\nfor sub in ('responses','chat_completions','messages'):\\n    p=base/sub/'viewer.py'\\n    spec=importlib.util.spec_from_file_location(f'test_{sub}',p)\\n    m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\\n    td=Path(tempfile.mkdtemp(prefix=f'viewer_{sub}_'))\\n    try:\\n        default={'json':{'model':'test-model','input':[{'role':'user','content':'old'}],'tools':[{'x':1}]}}\\n        (td/'input.json').write_text(json.dumps(default),encoding='utf8')\\n        named={'json':{'model':'named-model','input':[]}}\\n        (td/'input_named.json').write_text(json.dumps(named),encoding='utf8')\\n        m.ROOT=td;m.INPUT_FILE=td/'input.json';m.ACTIVE_FILE=td/'.ae_active_input';m.RUNNER_PID_FILE=td/'.pid';m._process=None\\n        m._invalidate_state_cache()\\n        m.ACTIVE_FILE.write_text('input_named.json\\\\n',encoding='utf8');m._restore_active_input()\\n        assert m.INPUT_FILE==td/'input_named.json'\\n        m.ACTIVE_FILE.write_text('input_x/../../outside.json\\\\n',encoding='utf8');m._restore_active_input()\\n        assert m.INPUT_FILE==td/'input.json'\\n        for bad in ('../x','x/y','x\\\\\\\\y',' name ','default/../x'):\\n            try:m._filename_for_chat_id(bad)\\n            except ValueError:pass\\n            else:raise AssertionError(('bad id accepted',bad))\\n        # create -> clears transcript and switches\\n        chat=m.create_chat('alpha')\\n        assert chat['id']=='alpha' and m.INPUT_FILE==td/'input_alpha.json'\\n        made=json.loads((td/'input_alpha.json').read_text('utf8'))\\n        assert made['json']['input']==[] and made['json']['tools']==[{'x':1}]\\n        m.rename_chat('alpha','beta');assert m.INPUT_FILE==td/'input_beta.json' and not (td/'input_alpha.json').exists()\\n        m.delete_chat('beta');assert m.INPUT_FILE==td/'input.json' and not (td/'input_beta.json').exists()\\n        # Cache must be keyed by active path, even if mtimes and sizes match and no explicit invalidation.\\n        a=td/'input_a.json';b=td/'input_b.json'\\n        payload_a={'json':{'model':'A'}};payload_b={'json':{'model':'B'}}\\n        sa=json.dumps(payload_a);sb=json.dumps(payload_b)\\n        assert len(sa)==len(sb)\\n        a.write_text(sa);b.write_text(sb)\\n        ns=1_700_000_000_000_000_000;os.utime(a,ns=(ns,ns));os.utime(b,ns=(ns,ns))\\n        converter_name={'responses':'response_transcript','chat_completions':'chat_transcript','messages':'anthropic_transcript'}[sub]\\n        setattr(m,converter_name,lambda body: [{'role':'assistant','content':body.get('model')}])\\n        m.INPUT_FILE=a;m._invalidate_state_cache();_,model_a,_=m.load_cached()\\n        m.INPUT_FILE=b  # deliberately do not invalidate: signature itself must distinguish files\\n        _,model_b,_=m.load_cached()\\n        assert (model_a,model_b)==('A','B'),(model_a,model_b)\\n        print(sub,'backend tests OK')\\n    finally:\\n        shutil.rmtree(td,ignore_errors=True)\\n\"}",
