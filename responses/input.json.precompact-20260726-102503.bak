        "name": "python",
        "arguments": "{\"code\":\"from pathlib import Path\\nimport ast,re\\nfrom html.parser import HTMLParser\\nroot=Path(r'C:\\\\Users\\\\12159\\\\Desktop\\\\ai_exec')\\npaths=[root/x/'viewer.py' for x in ('responses','chat_completions','messages')]\\nfor p in paths:\\n    text=p.read_text(encoding='utf-8')\\n    tree=ast.parse(text)\\n    page=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='PAGE' for t in n.targets))\\n    py_outside=len(text)-len(page)\\n    scripts=re.findall(r'<script(?:\\\\s[^>]*)?>([\\\\s\\\\S]*?)</script>',page,re.I)\\n    styles=''.join(re.findall(r'<style>([\\\\s\\\\S]*?)</style>',page,re.I))\\n    marked=len(scripts[1]) if len(scripts)>1 else 0\\n    purify=len(scripts[2]) if len(scripts)>2 else 0\\n    appjs=len(scripts[-1]) if scripts else 0\\n    external=re.findall(r'<script[^>]+src=\\\"([^\\\"]+)\\\"',page,re.I)\\n    print(p.parent.name, {'total_chars':len(text),'lines':text.count('\\\\n')+1,'PAGE_chars':len(page),'python_wrapper_approx':py_outside,'css_chars':len(styles),'marked_chars':marked,'dompurify_chars':purify,'app_js_chars':appjs,'external':external})\\n\\n# similarity: normalized line intersection among viewer files\\nsets=[]\\nfor p in paths:\\n    lines=[x for x in p.read_text('utf8').splitlines() if x.strip()]\\n    sets.append(lines)\\ncommon=set(sets[0]) & set(sets[1]) & set(sets[2])\\nfor p,lines in zip(paths,sets):\\n    common_occ=sum(1 for x in lines if x in common)\\n    print(p.parent.name,'nonblank lines',len(lines),'lines whose exact text occurs in all 3',common_occ, f'{common_occ/len(lines):.1%}')\\n\"}"
