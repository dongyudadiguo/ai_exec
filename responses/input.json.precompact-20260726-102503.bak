      {
        "arguments": "{\"code\":\"from pathlib import Path\\nimport importlib.util, tempfile, json, threading, shutil, time\\nfrom http.server import ThreadingHTTPServer\\n\\ntry:\\n    from playwright.sync_api import sync_playwright\\nexcept Exception as e:\\n    print('SKIP: Playwright import failed', e)\\n    raise SystemExit\\n\\nviewer_path=Path(r'C:\\\\Users\\\\12159\\\\Desktop\\\\ai_exec\\\\responses\\\\viewer.py')\\nspec=importlib.util.spec_from_file_location('viewer_integration',viewer_path)\\nv=importlib.util.module_from_spec(spec);spec.loader.exec_module(v)\\ntd=Path(tempfile.mkdtemp(prefix='viewer_browser_test_'))\\nserver=None;browser=None\\ntry:\\n    def write_chat(path, model):\\n        path.write_text(json.dumps({'json':{'model':model,'instructions':'','input':[]}},ensure_ascii=False),encoding='utf8')\\n    write_chat(td/'input.json','default-model')\\n    write_chat(td/'input_other.json','other-model')\\n    v.ROOT=td;v.INPUT_FILE=td/'input.json';v.ACTIVE_FILE=td/'.ae_active_input';v.AE_FILE=td/'ae.py';v.RUNNER_PID_FILE=td/'.pid';v._process=None\\n    v._invalidate_state_cache()\\n    server=ThreadingHTTPServer(('127.0.0.1',0),v.Handler);v._server=server\\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\\n    url=f'http://127.0.0.1:{server.server_address[1]}'\\n\\n    with sync_playwright() as pw:\\n        browser=pw.chromium.launch(headless=True)\\n        page=browser.new_page()\\n        errors=[]\\n        page.on('pageerror',lambda e: errors.append(str(e)))\\n        page.on('console',lambda msg: errors.append('console:'+msg.text) if msg.type=='error' else None)\\n        page.on('dialog',lambda d:d.accept())\\n        # Avoid external-network dependency during the integration test.\\n        def cdn(route):\\n            if route.request.resource_type=='script':\\n                route.fulfill(status=200,content_type='application/javascript',body=\\\"window.hljs={highlightElement:function(el){el.dataset.highlighted='yes';}};\\\")\\n            else:\\n                route.fulfill(status=200,content_type='text/css',body='')\\n        page.route('https://cdn.jsdelivr.net/**',cdn)\\n        # Hold the first chat-list and usage responses to exercise request queuing/generation guards.\\n        page.add_init_script(\\\"\\\"\\\"\\n        (()=>{\\n          const realFetch=window.fetch.bind(window);\\n          window.__chatReq=[]; window.__usageReq=[]; window.__holdChats=true; window.__holdUsage=true;\\n          window.fetch=(url,opts)=>{\\n            const s=String(url);\\n            if(window.__holdChats && s==='/api/chats'){\\n              return new Promise(resolve=>window.__chatReq.push(resolve));\\n            }\\n            if(window.__holdUsage && s==='/api/usage'){\\n              return new Promise(resolve=>window.__usageReq.push(resolve));\\n            }\\n            return realFetch(url,opts);\\n          };\\n          window.__resolveChat=(i,data)=>window.__chatReq[i](new Response(JSON.stringify(data),{status:200,headers:{'Content-Type':'application/json'}}));\\n          window.__resolveUsage=(i,total)=>window.__usageReq[i](new Response(JSON.stringify({updated:9e15,usage:{estimated_total:total},context_limit:1000}),{status:200,headers:{'Content-Type':'application/json'}}));\\n        })();\\n        \\\"\\\"\\\")\\n        page.goto(url,wait_until='domcontentloaded')\\n        page.wait_for_function('window.__chatReq.length===1 && window.__usageReq.length===1')\\n\\n        # A second load while the first is pending must be queued, not dropped.\\n        page.evaluate('loadChats()')\\n        page.evaluate(\\\"__resolveChat(0,{active:'default',chats:[{id:'default',name:'stale',mtime:1,active:true}]})\\\")\\n        page.wait_for_function('window.__chatReq.length===2')\\n        page.evaluate(\\\"__resolveChat(1,{active:'default',chats:[{id:'default',name:'默认',mtime:2,active:true},{id:'other',name:'other',mtime:1,active:false}]})\\\")\\n        page.wait_for_function(\\\"document.querySelectorAll('.chat-item').length===2\\\")\\n        page.evaluate('window.__holdChats=false')\\n\\n        # Switch chats while the old usage request is pending. Old usage must never paint.\\n        page.evaluate(\\\"selectChat('other')\\\")\\n        page.wait_for_function(\\\"activeChatId==='other'\\\")\\n        page.evaluate('__resolveUsage(0,111)')\\n        page.wait_for_function('window.__usageReq.length===2')\\n        page.evaluate('__resolveUsage(1,222)')\\n        page.wait_for_function(\\\"document.getElementById('usageText').textContent.includes('222')\\\")\\n        assert '111' not in page.locator('#usageText').inner_text()\\n        page.evaluate('window.__holdUsage=false')\\n\\n        # Deleting an inactive chat must preserve the active chat's unsent draft.\\n        page.fill('#message','draft must survive')\\n        page.evaluate(\\\"deleteChat('default')\\\")  # protected client-side: no-op, sanity only\\n        # Create another inactive file directly, refresh, then delete it through the real API.\\n        write_chat(td/'input_spare.json','spare-model')\\n        page.evaluate('loadChats()')\\n        page.wait_for_function(\\\"[...document.querySelectorAll('[data-chat-id]')].some(x=>x.dataset.chatId==='spare')\\\")\\n        page.evaluate(\\\"deleteChat('spare')\\\")\\n        page.wait_for_function(\\\"![...document.querySelectorAll('[data-chat-id]')].some(x=>x.dataset.chatId==='spare')\\\")\\n        assert page.input_value('#message')=='draft must survive'\\n        assert not (td/'input_spare.json').exists()\\n\\n        # Switching really persisted the active pointer.\\n        assert (td/'.ae_active_input').read_text('utf8').strip()=='input_other.json'\\n        assert not errors, errors\\n        print('responses browser integration OK')\\n        browser.close();browser=None\\nfinally:\\n    if browser:\\n        try: browser.close()\\n        except Exception: pass\\n    if server:\\n        try: server.shutdown();server.server_close()\\n        except Exception: pass\\n    v._server=None\\n    shutil.rmtree(td,ignore_errors=True)\\n\"}",
