        "arguments": "{\"code\":\"from pathlib import Path\\nimport ast, re, subprocess, tempfile, shutil, sys\\np=Path(r'C:\\\\Users\\\\12159\\\\Desktop\\\\ai_exec\\\\responses\\\\viewer.py')\\ntext=p.read_text(encoding='utf-8')\\nprint('PYTHON COMPILE:')\\ntry:\\n    compile(text,str(p),'exec')\\n    print('  OK')\\nexcept SyntaxError as e:\\n    print('  FAIL',e)\\n\\nmod=ast.parse(text)\\npage=None\\nfor node in mod.body:\\n    if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='PAGE' for t in node.targets):\\n        page=ast.literal_eval(node.value)\\n        break\\nprint('PAGE:', len(page) if page is not None else None)\\n\\n# Basic mojibake indicators generated by UTF-8 -> GBK(errors=ignore)\\nindicators=['锛','鈥','瀵硅瘽','榛樿','鏂板','杩','绌洪棽','宸ュ叿']\\nprint('MOJIBAKE indicators:', {s:text.count(s) for s in indicators})\\n\\nfrom html.parser import HTMLParser\\nclass Scripts(HTMLParser):\\n    def __init__(self):\\n        super().__init__(); self.scripts=[]; self.in_script=False; self.cur=[]; self.attrs=[]\\n    def handle_starttag(self, tag, attrs):\\n        if tag.lower()=='script':\\n            self.in_script=True; self.cur=[]; self.attrs.append(dict(attrs))\\n    def handle_data(self,data):\\n        if self.in_script:self.cur.append(data)\\n    def handle_endtag(self,tag):\\n        if tag.lower()=='script' and self.in_script:\\n            self.scripts.append(''.join(self.cur)); self.in_script=False\\nh=Scripts(); h.feed(page)\\nprint('inline/external scripts:', len(h.scripts), h.attrs)\\nnode=shutil.which('node')\\nprint('NODE:', node)\\nif node:\\n    td=Path(tempfile.mkdtemp(prefix='viewer_check_'))\\n    try:\\n        for i,s in enumerate(h.scripts):\\n            if not s.strip():\\n                print(f'  script {i}: external/empty')\\n                continue\\n            q=td/f'script_{i}.js'; q.write_text(s,encoding='utf-8')\\n            cp=subprocess.run([node,'--check',str(q)],capture_output=True,text=True,encoding='utf-8',errors='replace')\\n            print(f'  script {i}:', 'OK' if cp.returncode==0 else 'FAIL')\\n            if cp.returncode:\\n                print(cp.stderr[:3000])\\n    finally:\\n        shutil.rmtree(td,ignore_errors=True)\\n\\n# Print all application-JS lines containing suspicious unmatched backtick heuristic or known relevant funcs\\napp=h.scripts[-1]\\nfor n,line in enumerate(app.splitlines(),1):\\n    if any(k in line for k in ['showNewMessages','const status=','newMessagesBtn.textContent','tool-title']) or (line.count('`')%2==1):\\n        print(f'APP {n}: {line}')\"}",
