o = t[t.find(\\\"/* Single/empty chat:\\\"):t.find(\\\"/* Single/empty chat:\\\")+900]\\n    assert \\\"right:max\\\" not in solo\\n    assert \\\"bottom:max\\\" not in solo\\n    p.write_text(t, encoding=\\\"utf-8\\\")\\n    py_compile.compile(str(p), doraise=True)\\n    scripts = re.findall(r\\\"<script(?:\\\\s[^>]*)?>(.*?)</script>\\\", t, re.S|re.I)\\n    bad=False\\n    for i,s in enumerate(scripts):\\n        if not s.strip(): continue\\n        with tempfile.NamedTemporaryFile(\\\"w\\\", suffix=\\\".js\\\", delete=False, encoding=\\\"utf-8\\\") as f:\\n            f.write(s); path=f.name\\n        r = subprocess.run([\\\"node\\\",\\\"--check\\\",path], capture_output=True, text=True)\\n        os.unlink(path)\\n        if r.returncode!=0:\\n            print(\\\"FAIL\\\", d, i, r.stderr[:300]); bad=True\\n    print(d, \\\"OK\\\" if not bad else \\\"JSERR\\\")\"}",
